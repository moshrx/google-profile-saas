{
  "version": 2,
  "routes": [
    {
      "src": "/geo-audit/?",
      "dest": "/geo-audit/index.html"
    },
    {
      "src": "/grants/?",
      "dest": "/grants/index.html"
    },
    {
      "src": "/pickupai/?",
      "dest": "/pickupai/index.html"
    },
    {
      "src": "/admin/leads/?",
      "dest": "/admin/leads/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
