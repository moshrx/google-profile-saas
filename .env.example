# Server-only. Never prefix this key with VITE_ and never commit the real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional: enables a rendered-browser fallback when a website blocks direct GEO audit requests.
# Create a server-side token at browserless.io. Never expose it through a VITE_ variable.
BROWSERLESS_API_TOKEN=
# Optional regional/self-hosted override. Must use HTTPS.
BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io/content

# Existing email delivery configuration. Prefer these server-only names in Vercel.
EMAILJS_SERVICE_ID=
EMAILJS_KIT_TEMPLATE_ID=
EMAILJS_LEAD_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional: use an EmailJS private key when your plan supports it.
EMAILJS_PRIVATE_KEY=
SUPPORT_EMAIL=peiwebstudio@gmail.com
